{
  "name": "dmptool-ui-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for dmptool-ui, run against dmptool-apollo-server and dmptool-auth",
  "type": "module",
  "scripts": {
    "test": "playwright test",
    "test:chromium": "playwright test --project=chromium",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --project=chromium --headed",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5"
  }
}
