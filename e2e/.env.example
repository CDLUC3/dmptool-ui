# Copy to .env (git-ignored) and fill in the passwords.
# Defaults below match the local seed data in dmptool-apollo-server (data-migrations/local-only).

# Where the UI and Apollo are running
BASE_URL=http://localhost:3000
GRAPHQL_URL=http://localhost:4000/graphql

# Non-SSO test accounts, one per role
E2E_RESEARCHER_EMAIL=researcher@example.com
E2E_RESEARCHER_PASSWORD=
E2E_ADMIN_EMAIL=admin@nsf.com
E2E_ADMIN_PASSWORD=Password123$9
